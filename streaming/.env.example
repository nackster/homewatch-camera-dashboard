# Copy this file to .env on the trusted computer beside the DVR.
# Create a dedicated read-only DVR account and URL-encode special password characters.
MTX_PATHS_CAM1_SOURCE=rtsp://viewer:change-me@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0
MTX_PATHS_CAM2_SOURCE=rtsp://viewer:change-me@192.168.1.100:554/cam/realmonitor?channel=2&subtype=0
MTX_PATHS_CAM3_SOURCE=rtsp://viewer:change-me@192.168.1.100:554/cam/realmonitor?channel=3&subtype=0
MTX_PATHS_CAM4_SOURCE=rtsp://viewer:change-me@192.168.1.100:554/cam/realmonitor?channel=4&subtype=0
